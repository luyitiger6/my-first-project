# 构建产物
target/
*.class
*.jar
!.mvn/wrapper/maven-wrapper.jar

# 前端（Node，根级双保险；frontend/.gitignore 另有同规则）
node_modules/
frontend/dist/

# E2E：运行产物不入库（截图仅用于失败定位与本地复核）
docs/e2e/test-results/
docs/e2e/playwright-report/
docs/e2e/screenshots/

# IDE
.idea/
*.iml
*.ipr
*.iws
.vscode/

# 日志与临时文件
logs/
*.log
*.tmp
.scaffold-tmp/

# 操作系统
.DS_Store
Thumbs.db

# AI 工具的本地私有配置（团队共享的 commands/skills 要提交，私有配置不要）
.claude/settings.local.json
.qoder/*.local.json
